# fw_env config for DriveNets AST2600/AST2620 NOR flash
#
# Allows Linux userspace to read/write U-Boot environment variables via
# fw_printenv and fw_setenv — used by firmware update scripts.
#
# Must match the U-Boot kconfig:
#   CONFIG_ENV_OFFSET    = 0x120000  (1152 KB — FLASH_UBOOT_ENV_OFFSET)
#   CONFIG_ENV_SIZE      = 0x20000   (128 KB)
#   CONFIG_ENV_SECT_SIZE = 0x10000   (64 KB erase block)
#
# Format: MTD device  Device offset  Env size  Flash sector size
/dev/mtd/u-boot-env	0x0000		0x20000		0x10000
