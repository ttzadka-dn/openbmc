//
// DriveNets Q2C BMC Device Tree
// BMC SoC: ASPEED AST2620 (AST2600-family variant)
//
// ============================================================================
// ARCHITECTURE (confirmed from schematic 8AESQ2CMB0A1G_SCH_20251217D
//               and I2C tree diagram Q2C_I2C_Tree_20260123)
// ============================================================================
//
//  The AST2620 BMC is on the DC-SCM (Data Center Secure Control Module),
//  an OCP DC-SCM v2 form-factor module manufactured by Alpha Networks
//  (part number 8AESQ2CMB0A1G).  The DC-SCM plugs into the Q2C carrier board
//  via a Gold Finger connector.
//
//  I2C Bus Map (confirmed from schematic signal names and I2C tree):
//    Bus 0 (I2C_3V3_0) : SCM FRU EEPROM at 0x50
//    Bus 4 (I2C_3V3_4) : PCA9539#27 GPIO expander at 0x74 (BIOS updates)
//    Bus 5 (I2C_3V3_5) : Main sensor/management bus
//      Direct:  UCD90120A (0x34), TMP435 (0x4D), TMP75#0-3 (0x48-0x4B)
//      Muxed:   PCA9548#16 (0x72) fan ext board, PCA9548#15 (0x71) PSU/VR
//
//  Host CPU: AMD x86 (COMe module)
//
//  Management networking:
//    OOB NIC — Intel I210 via PCIe Gen2 x1 (reset: I210_RST_L, sch pg 4/55)
//    NCSI    — AMD x86 COMe NIC → DC-SCM MAC (TBD: mac0 or mac1)
//
//  UART / Console:
//    UART0_BMC + UART1_BMC → physical MUX (UART_SEL push-button)
//    MUX output → Console Board → UART_RJ45 (RS-232)
//    Console UART: TBD (ttyS0 or ttyS4)
//
//  SGPIO → SCM PLD → panel LEDs (bit assignments TBD)
//
//  Fan control: mechanism TBD (no dedicated fan controller IC found;
//               possibly via CPLD/PLD or fan module built-in controllers)
// ============================================================================

// TODO: For production, replace this EVB include with the SoC dtsi
// (#include "aspeed-g6.dtsi") and explicitly enable only the peripherals
// Q2C needs (fmc, spi, uart, mac, i2c, etc.).  Keeping EVB for now to
// inherit working flash/uart/mac defaults while I2C topology is validated.
#include "aspeed-ast2600-evb.dts"

/ {
	model = "DriveNets Q2C DC-SCM BMC";
	// AST2620 is a variant of AST2600; include both for kernel matching.
	compatible = "drivenets,q2c-bmc", "aspeed,ast2620", "aspeed,ast2600";
};

// ---------------------------------------------------------------------------
// i2c0 — SCM local bus (I2C_3V3_0, Gold Finger A15/A16)
//
// Confirmed: FRU EEPROM only.
// Signal: SCL0/SDA0 on DC-SCM connector.
// ---------------------------------------------------------------------------
&i2c0 {
	status = "okay";

	scm_fru: eeprom@50 {
		compatible = "atmel,24c128";
		reg = <0x50>;
		label = "scm_fru";
		pagesize = <64>;
	};
};

// ---------------------------------------------------------------------------
// i2c4 — BIOS update bus (I2C_3V3_4, Gold Finger A45/A46)
//
// Confirmed: PCA9539#27 GPIO expander for BIOS updates.
// ---------------------------------------------------------------------------
&i2c4 {
	status = "okay";

	bios_gpio: pca9539@74 {
		compatible = "nxp,pca9539";
		reg = <0x74>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

// ---------------------------------------------------------------------------
// i2c5 — Main sensor/management bus (I2C_3V3_5, Gold Finger A47/A48)
//
// Signal name: SCL5_BMC_CPLD_UCD_FRU / SDA5_BMC_CPLD_UCD_FRU
//
// Direct devices (confirmed from schematic pg 34 and I2C tree):
//   UCD90120A   — power sequencer at 0x34
//   TMP435      — dual-channel temp (local + CPU remote) at 0x4D
//   TMP75#0     — Ambient Thermal Sensor For AFO at 0x48
//   TMP75#1     — Hot Spot Thermal Sensor at 0x49
//   TMP75#2     — Hot Spot Thermal Sensor For AFI at 0x4A
//   TMP75#3     — Thermal Sensor For OP2 at 0x4B
//
// Muxed devices:
//   PCA9548#16  — Fan Extension Board mux at 0x72 (reset: 9548#16_RST_L)
//   PCA9548#15  — PSU / Voltage Regulator mux at 0x71
// ---------------------------------------------------------------------------
&i2c5 {
	status = "okay";

	ucd90120a: ucd90120a@34 {
		compatible = "ti,ucd90120a";
		reg = <0x34>;
	};

	tmp435: temperature-sensor@4d {
		compatible = "ti,tmp435";
		reg = <0x4d>;
		label = "cpu_temp";
		#thermal-sensor-cells = <1>;
	};

	tmp75_0: temperature-sensor@48 {
		compatible = "ti,tmp75";
		reg = <0x48>;
		label = "ambient_temp_afo";
		#thermal-sensor-cells = <0>;
	};

	tmp75_1: temperature-sensor@49 {
		compatible = "ti,tmp75";
		reg = <0x49>;
		label = "hotspot_temp";
		#thermal-sensor-cells = <0>;
	};

	tmp75_2: temperature-sensor@4a {
		compatible = "ti,tmp75";
		reg = <0x4a>;
		label = "hotspot_temp_afi";
		#thermal-sensor-cells = <0>;
	};

	tmp75_3: temperature-sensor@4b {
		compatible = "ti,tmp75";
		reg = <0x4b>;
		label = "op2_temp";
		#thermal-sensor-cells = <0>;
	};

	// PCA9548#16 — Fan Extension Board mux
	fan_mux: i2c-mux@72 {
		compatible = "nxp,pca9548";
		reg = <0x72>;
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux-idle-disconnect;

		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			fan0_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan0_fru";
			};
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			fan1_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan1_fru";
			};
		};

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
			fan2_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan2_fru";
			};
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			fan3_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan3_fru";
			};
		};

		i2c@4 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <4>;
			fan_board_eeprom: eeprom@57 {
				compatible = "atmel,24c32";
				reg = <0x57>;
				label = "fan_board_fru";
			};
		};
	};

	// PCA9548#15 — PSU and Voltage Regulator mux
	psu_vr_mux: i2c-mux@71 {
		compatible = "nxp,pca9548";
		reg = <0x71>;
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux-idle-disconnect;

		// CH0: PSU0 (via ISO level shifter)
		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			psu0: power-supply@58 {
				compatible = "pmbus";
				reg = <0x58>;
				label = "psu0";
			};
			psu0_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "psu0_fru";
			};
		};

		// CH1: PSU1 (via ISO level shifter)
		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			psu1: power-supply@58 {
				compatible = "pmbus";
				reg = <0x58>;
				label = "psu1";
			};
			psu1_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "psu1_fru";
			};
		};

		// CH3: Voltage regulators
		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			xdpe1a2g5bv: pmbus@76 {
				compatible = "pmbus";
				reg = <0x76>;
			};
			tda38740a: pmbus@45 {
				compatible = "pmbus";
				reg = <0x45>;
			};
			tps549a20: pmbus@1d {
				compatible = "pmbus";
				reg = <0x1d>;
			};
			xdpe19284c: pmbus@60 {
				compatible = "pmbus";
				reg = <0x60>;
			};
		};
	};
};

// ---------------------------------------------------------------------------
// SGPIO — drives Q2C carrier board panel LEDs via SCM PLD
//
// Bit assignments are PLACEHOLDERS — verify from SCM PLD firmware.
// ---------------------------------------------------------------------------
&sgpio {
	status = "okay";
	ngpios = <32>;
	gpio-line-names =
		"led-system-green",  "led-system-amber",
		"led-psu0-green",    "led-psu0-amber",
		"led-psu1-green",    "led-psu1-amber",
		"led-fan-green",     "led-fan-amber",
		"led-sync-green",    "led-sync-amber",
		"led-fan0-green",    "led-fan0-amber",
		"led-fan1-green",    "led-fan1-amber",
		"led-fan2-green",    "led-fan2-amber",
		"led-fan3-green",    "led-fan3-amber",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

// ---------------------------------------------------------------------------
// GPIO — named lines from the DC-SCM / carrier board
//
// Signal names confirmed from schematic (pg 4, 32, 34, 94, 103).
// Exact AST2620 GPIO pin assignments (bank/bit) are TBD — the signal
// names below are placed in E0-E7 as PLACEHOLDERS.  Update once the
// DC-SCM schematic GPIO mapping table is available.
// ---------------------------------------------------------------------------
&gpio0 {
	gpio-line-names =
	// A0-A7
	"", "", "", "", "", "", "", "",
	// B0-B7
	"", "", "", "", "", "", "", "",
	// C0-C7
	"", "", "", "", "", "", "", "",
	// D0-D7
	"", "", "", "", "", "", "", "",
	// E0-E7  (PLACEHOLDER pin assignments — signal names confirmed)
	"psu0-present-l", "psu1-present-l",
	"psu0-power-good", "psu1-power-good",
	"psu0-acok", "psu1-acok",
	"psu0-pson-l", "psu1-pson-l",
	// F0-F7  (PLACEHOLDER pin assignments — signal names confirmed)
	"push-btn-rst-l", "sus-s3-l",
	"sus-s4-l", "sus-s5-l",
	"pwr-ok", "cpu-mb-cb-rst-l",
	"rsmrst-out-l", "cpu-mb-wdt",
	// G0-G7
	"mb-cpu-thrm-l", "i210-rst-l",
	"", "", "", "", "", "",
	// H0-H7
	"", "", "", "", "", "", "", "";
};

// ---------------------------------------------------------------------------
// Fan PWM/tach — NOT driven directly by AST2620 PWM hardware.
// Fan control mechanism is TBD (possibly via CPLD/PLD over I2C bus 5,
// or fan module built-in controllers).
// ---------------------------------------------------------------------------
&pwm_tacho {
	status = "disabled";
};

// ---------------------------------------------------------------------------
// UART / Console
//
// UART0_BMC + UART1_BMC → physical MUX → Console Board → UART_RJ45
// Console UART: TBD (ttyS0 or ttyS4) — verify from U-Boot boot log.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Management Network
//
// 1. OOB NIC — Intel I210 via PCIe Gen2 x1 (reset: I210_RST_L)
// 2. NCSI — AMD x86 COMe NIC → DC-SCM MAC (TBD: mac0 or mac1)
//
// Uncomment once the correct MAC is identified:
// ---------------------------------------------------------------------------
// &mac1 {
//     use-ncsi;
// };

// ---------------------------------------------------------------------------
// RESOLVED from schematic analysis:
//  [x] I2C bus numbers: bus 0 = FRU, bus 4 = BIOS GPIO, bus 5 = sensors/muxes
//  [x] FRU EEPROM: AT24C128 at 0x50 on bus 0
//  [x] TMP435 address: 0x4D on bus 5
//  [x] TMP75 addresses: 0x48, 0x49, 0x4A, 0x4B on bus 5
//  [x] UCD90120A power sequencer: 0x34 on bus 5
//  [x] PCA9548#16 fan mux: 0x72 on bus 5, CH0-3=fan EEPROMs, CH4=board EEPROM
//  [x] PCA9548#15 PSU/VR mux: 0x71 on bus 5, CH0=PSU0, CH1=PSU1, CH3=VRs
//  [x] PSU PMBus address: 0x58 (both PSU0 and PSU1)
//  [x] PSU mux channels: CH0=PSU0, CH1=PSU1 (not CH5/CH6 as initially guessed)
//  [x] GPIO signal names: PSU presence/ACOK/PWOK/PSON, host control signals
//
// REMAINING TBD:
//  1. Fan control hardware interface (CPLD? GPIO PWM? Fan module registers?)
//  2. SGPIO bit assignments for panel LEDs (need SCM PLD firmware docs)
//  3. Which MAC for NCSI (mac0 or mac1)
//  4. Console UART (ttyS0 vs ttyS4)
//  5. DRAM size and SPI flash size
//  6. Exact GPIO pin assignments (bank/bit) for all named signals
//  7. SCM PLD mailbox chip model and address (bus 0 or bus 5)
//  8. PCA9539#27 usage details for BIOS updates (bus 4)
// ---------------------------------------------------------------------------
