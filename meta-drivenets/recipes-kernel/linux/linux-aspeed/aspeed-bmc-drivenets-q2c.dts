// SPDX-License-Identifier: GPL-2.0+
// Copyright (c) 2024 DriveNets
//
// DriveNets Q2C BMC Device Tree
// BMC SoC: ASPEED AST2620 (AST2600-family variant)
//
// ============================================================================
// ARCHITECTURE (confirmed from schematic 8AESQ2SCM0A1G_SCH_20260203 PDF read
//               2026-03-05, and I2C tree diagram Q2C_I2C_Tree_20260123)
// ============================================================================
//
//  The AST2620 BMC is on the DC-SCM (Data Center Secure Control Module),
//  an OCP DC-SCM v2 form-factor module manufactured by Alpha Networks
//  (part number 8AESQ2CMB0A1G).  The DC-SCM plugs into the Q2C carrier board
//  via a Gold Finger connector.
//
//  I2C Bus Map (confirmed from block diagram and schematic):
//
//  LOCAL DC-SCM bus (BMC_I2C15, GPIOH4/H5, signal I2C_BMC_R_SCL15/SDA15):
//    &i2c15 : TEMP1@0x48, TEMP2@0x49, FRU EE@0x50, RTC@0x32,
//             PMIC@0x14, SCM PLD@0x40
//
//  Gold Finger (SCI-CONN) buses — AST2620 controller → connector signal → pins:
//    &i2c11 (BMC_I2C11) → I2C_3V3_0  → A15/A16  (carrier devices TBD)
//    &i2c10 (BMC_I2C10) → I2C_3V3_4  → A45/A46  (PCA9539#27 BIOS GPIO @0x74)
//    &i2c5  (BMC_I2C5)  → I2C_3V3_5  → A47/A48  (UCD90120A, TMP435, TMP75s,
//                                                   PCA9548#16 fan, PCA9548#15 PSU/VR)
//    &i2c8  (BMC_I2C8)  → I2C_I3C_1V8_13 → A61/A62  (via VT, TBD)
//    &i2c16 (BMC_I2C16) → PFR I3C1   → I2C_I3C_1V8_14 → B39/B40 (via MIX)
//    [further I3C/HVI3C buses: I2C2/3/4→HVI3C4/5/6, I3C1/2 on 1V0 — TBD]
//
//  PFR chip: PROT_AST1060 (Aspeed AST1060)
//    BMC → AST1060: via BMC_I2C12, BMC_I2C7, BMC_I2C9, BMC_I2C6, BMC_HVI3C3
//    AST1060 → gold finger: SMBF1→I2C_3V3_2(A26/A27), SMBF2→I2C_3V3_1(A17/A18),
//                           SMBF3→I2C_3V3_3(A43/A44), SMBF4→TBD
//    AST1060 mailbox: PFR_I2C3 → VT → I2C_I3C_1V8_12 (A53/A59)
//    AST1060 → SCM PLD: PFR_I2C5 → I2C_3V3_6 (A49/A50), PLD @0x6F (TBD)
//
//  Host CPU: AMD x86 (COMe module)
//
//  Host ↔ BMC interface: LPC — BMC receives LPC from eSPI-to-LPC bridge
//    AMD COMe CPU → eSPI → ESPI_HPMCTRL bridge chip → LPC → BMC AST2620
//    The bridge chip (labeled ESPI_HPMCTRL in schematic) converts the CPU's
//    eSPI to LPC which the BMC AST2620 receives on its GPIOW LPC pins.
//
//    AST2620 LPC pins (GPIOW bank):
//      AE7 = GPIOW4_LCLK_ESPICK  → LCLK  (LPC clock from bridge)
//      AF6 = GPIOW7_LPCRST_ESPIRST# → LRST (LPC reset from bridge)
//      AB7 = GPIOW0_LAD0_ESPID0  ↔ LAD0  (LPC data, via ESPI_HPMCTRL_IO_0)
//      AB5 = GPIOW1_LAD1_ESPID1  ↔ LAD1  (via ESPI_HPMCTRL_IO_1)
//      AD5 = GPIOW2_LAD2_ESPID2  ↔ LAD2  (via ESPI_HPMCTRL_IO_2)
//      AE5 = GPIOW3_LAD3_ESPID3  ↔ LAD3  (via ESPI_HPMCTRL_IO_3)
//    KCS IPMI channels are exposed over LPC transport.
//
//  Management networking:
//    OOB NIC — Intel I210 via PCIe Gen2 x1 (reset: I210_RST_L, sch pg 4/55)
//    NCSI    — AMD x86 COMe NIC → DC-SCM MAC (TBD: mac0 or mac1)
//
//  UART / Console:
//    UART0_BMC + UART1_BMC → physical MUX (UART_SEL push-button)
//    MUX output → Console Board → UART_RJ45 (RS-232)
//    Console UART: ttyS4 (UART5) — confirmed via ast2600_openbmc_spl_defconfig
//    CONFIG_BOOTARGS="console=ttyS4,115200n8 root=/dev/ram rw"
//
//  SGPIO:
//    SGPIOM1 (GPIOH0-H3) → SCM PLD → panel LEDs  (only chain, confirmed)
//    SGPIOM0: NOT used — no SGPIOM0 signals found in schematic.
//
//  Fan control: via SCM PLD (I2C15 @0x40) — PLD generates PWM/tach signals.
//    AST2620 GPIOF0-F7 carry PWM8-15 function but are pulled-down on Q2C
//    (R31T 100k pull-down = unused).  Fan setpoints written to PLD over I2C.
// ============================================================================

// TODO: For production, replace this EVB include with the SoC dtsi
// (#include "aspeed-g6.dtsi") and explicitly enable only the peripherals
// Q2C needs (fmc, spi, uart, mac, i2c, etc.).  Keeping EVB for now to
// inherit working flash/uart/mac defaults while I2C topology is validated.
#include "aspeed-ast2600-evb.dts"

/ {
	model = "DriveNets Q2C DC-SCM BMC";
	// AST2620 is a variant of AST2600; include both for kernel matching.
	compatible = "drivenets,q2c-bmc", "aspeed,ast2620", "aspeed,ast2600";
};

// ---------------------------------------------------------------------------
// i2c11 — Gold Finger I2C_3V3_0 (BMC_I2C11, connector pins A15/A16)
//
// This bus reaches the carrier board via the gold finger connector.
// SCM FRU EEPROM is on the LOCAL bus i2c15 (not here).
// Carrier-side devices on this bus: TBD.
// ---------------------------------------------------------------------------
&i2c11 {
	status = "okay";
	/* TODO: add carrier-board devices on I2C_3V3_0 once identified */
};

// ---------------------------------------------------------------------------
// i2c10 — BIOS update bus (BMC_I2C10, Gold Finger I2C_3V3_4, pins A45/A46)
//
// Confirmed: PCA9539#27 GPIO expander at 0x74 for BIOS SPI updates.
// ---------------------------------------------------------------------------
&i2c10 {
	status = "okay";

	bios_gpio: pca9539@74 {
		compatible = "nxp,pca9539";
		reg = <0x74>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

// ---------------------------------------------------------------------------
// i2c5 — Main sensor/management bus (I2C_3V3_5, Gold Finger A47/A48)
//
// Signal name: SCL5_BMC_CPLD_UCD_FRU / SDA5_BMC_CPLD_UCD_FRU
//
// Direct devices (confirmed from schematic pg 34 and I2C tree):
//   UCD90120A   — power sequencer at 0x34
//   TMP435      — dual-channel temp (local + CPU remote) at 0x4D
//   TMP75#0     — Ambient Thermal Sensor For AFO at 0x48
//   TMP75#1     — Hot Spot Thermal Sensor at 0x49
//   TMP75#2     — Hot Spot Thermal Sensor For AFI at 0x4A
//   TMP75#3     — Thermal Sensor For OP2 at 0x4B
//
// Muxed devices:
//   PCA9548#16  — Fan Extension Board mux at 0x72 (reset: 9548#16_RST_L)
//   PCA9548#15  — PSU / Voltage Regulator mux at 0x71
// ---------------------------------------------------------------------------
&i2c5 {
	status = "okay";

	ucd90120a: ucd90120a@34 {
		compatible = "ti,ucd90120a";
		reg = <0x34>;
	};

	tmp435: temperature-sensor@4d {
		compatible = "ti,tmp435";
		reg = <0x4d>;
		label = "cpu_temp";
		#thermal-sensor-cells = <1>;
	};

	tmp75_0: temperature-sensor@48 {
		compatible = "ti,tmp75";
		reg = <0x48>;
		label = "ambient_temp_afo";
		#thermal-sensor-cells = <0>;
	};

	tmp75_1: temperature-sensor@49 {
		compatible = "ti,tmp75";
		reg = <0x49>;
		label = "hotspot_temp";
		#thermal-sensor-cells = <0>;
	};

	tmp75_2: temperature-sensor@4a {
		compatible = "ti,tmp75";
		reg = <0x4a>;
		label = "hotspot_temp_afi";
		#thermal-sensor-cells = <0>;
	};

	tmp75_3: temperature-sensor@4b {
		compatible = "ti,tmp75";
		reg = <0x4b>;
		label = "op2_temp";
		#thermal-sensor-cells = <0>;
	};

	// PCA9548#16 — Fan Extension Board mux
	fan_mux: i2c-mux@72 {
		compatible = "nxp,pca9548";
		reg = <0x72>;
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux-idle-disconnect;

		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			fan0_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan0_fru";
			};
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			fan1_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan1_fru";
			};
		};

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
			fan2_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan2_fru";
			};
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			fan3_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "fan3_fru";
			};
		};

		i2c@4 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <4>;
			fan_board_eeprom: eeprom@57 {
				compatible = "atmel,24c32";
				reg = <0x57>;
				label = "fan_board_fru";
			};
		};
	};

	// PCA9548#15 — PSU and Voltage Regulator mux
	psu_vr_mux: i2c-mux@71 {
		compatible = "nxp,pca9548";
		reg = <0x71>;
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux-idle-disconnect;

		// CH0: PSU0 (via ISO level shifter)
		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			psu0: power-supply@58 {
				compatible = "pmbus";
				reg = <0x58>;
				label = "psu0";
			};
			psu0_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "psu0_fru";
			};
		};

		// CH1: PSU1 (via ISO level shifter)
		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			psu1: power-supply@58 {
				compatible = "pmbus";
				reg = <0x58>;
				label = "psu1";
			};
			psu1_eeprom: eeprom@50 {
				compatible = "atmel,24c32";
				reg = <0x50>;
				label = "psu1_fru";
			};
		};

		// CH3: Voltage regulators
		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			xdpe1a2g5bv: pmbus@76 {
				compatible = "pmbus";
				reg = <0x76>;
			};
			tda38740a: pmbus@45 {
				compatible = "pmbus";
				reg = <0x45>;
			};
			tps549a20: pmbus@1d {
				compatible = "pmbus";
				reg = <0x1d>;
			};
			xdpe19284c: pmbus@60 {
				compatible = "pmbus";
				reg = <0x60>;
			};
		};
	};
};

// ---------------------------------------------------------------------------
// SGPIOM1 — drives Q2C carrier board panel LEDs via SCM PLD
//
// Hardware: SGPIOM1_BMC_PLD_{CLK,LD,DO} → PLD (OUT on GPIOH0/H1/H2)
//           SGPIOM1_PLD_BMC_DI ← PLD (IN on GPIOH3)
// AST2620 pins: GPIOH0=A18, GPIOH1=B18, GPIOH2=C18, GPIOH3=A17
// Schematic: SGPIOM1 (not SGPIOM0) — confirmed from schematic I2C/SGPIO page.
//
// Bit assignments are PLACEHOLDERS — verify from SCM PLD firmware.
// ---------------------------------------------------------------------------
&sgpiom1 {
	status = "okay";
	ngpios = <32>;
	gpio-line-names =
		"led-system-green",  "led-system-amber",
		"led-psu0-green",    "led-psu0-amber",
		"led-psu1-green",    "led-psu1-amber",
		"led-fan-green",     "led-fan-amber",
		"led-sync-green",    "led-sync-amber",
		"led-fan0-green",    "led-fan0-amber",
		"led-fan1-green",    "led-fan1-amber",
		"led-fan2-green",    "led-fan2-amber",
		"led-fan3-green",    "led-fan3-amber",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

// ---------------------------------------------------------------------------
// GPIO — named lines from the DC-SCM / carrier board
//
// ARCHITECTURE NOTE (confirmed from full schematic PDF 8AESQ2SCM0A1G_SCH_20260203,
//                   read 2026-03-05):
//   Platform signals route through the SCM PLD.  The BMC monitors PLD→BMC status
//   via the GPIOQ bank (TACH0-7 function pins) and GPIOR bank (TACH8-15 function
//   pins).  BMC control outputs to PLD use the GPIOO bank (PWM0-7 function) and
//   GPIOP bank (PWM8-15/THRU function).
//
//   GPIO bank layout (all balls confirmed from pg 23 "AST2600 4/6", 2026-03-05):
//
//   GPIOO (PWM0-7 function — BMC→PLD control outputs):
//     O0 (AD26)  O1 (AD22)  O2 (AD23)  O3 (AD24)
//     O4 (AD25)  O5 (AC22)  O6 (AC24)  O7 (AC23)
//     Signals from PLD pg 27: BMC_PLD_GPIOO1/2/3/6/7
//
//   GPIOP (PWM8-15/THRU function — mixed):
//     P0 (AB22) THRUIN0   P1 (W24) THRUOUT0   P2 (AA23) THRUIN1   P3 (AA24) THRUOUT1
//     P4 (W23) THRUIN2    P5 (AB23) THRUOUT2   P6 (AB24)            P7 (Y23) HBLED#
//
//   GPIOQ (TACH0-7 function — PLD→BMC status inputs):
//     Q0 (AA25)  Q1 (AB25)  Q2 (Y24)  Q3 (AB26)
//     Q4 (Y26)   Q5 (AC26)  Q6 (Y25)  Q7 (AA26)
//     Signals from PLD pg 27/28/31: PLD_BMC_GPIOQ0/3/4/5/6/7
//
//   GPIOR (TACH8-15 function — mixed):
//     R0 (V25)  R1 (U24)  R2 (V24)  R3 (V26)
//     R4 (U25)  R5 (T23)  R6 (W26)  R7 (U26)
//     R0-R2: PLD_BMC_GPIOR0/1/2 (inputs)    R4: FM_BMC_READY_N (output)
//     R5: PWRGD_P12V_AUX1 (input)            R6: FM_THERMTRIP_N (input)
//     R7: IRQ_SMI_BMC_N (input from PLD)
//
//   GPIOB0 (J26): hpm-bmc-stby-rdy (SALT1 mode, input from HPM FPGA)
// ---------------------------------------------------------------------------
&gpio0 {
	gpio-line-names =
	// A0-A7
	// A4-A7: SGPIOM2 function (SGPM2CK/LD/O/I to SCM PLD) — see sgpiom2 node
	"", "", "", "", "", "", "", "",
	// B0-B7
	// B0 (J26) = GPIOB0_SALT1: hpm-bmc-stby-rdy (input from HPM FPGA)
	// B1 (K23) = GPIOB1_SALT2: signal TBD
	// B6 (H25) = GPIOB6_TXD4: UART4 TX to PLD [pg 27]
	// B7 (J24) = GPIOB7_RXD4: UART4 RX from PLD [pg 27]
	"hpm-bmc-stby-rdy", "", "", "", "", "", "", "",
	// C0-C7 (RGMII3/MAC3 pins — not used as named GPIOs)
	"", "", "", "", "", "", "", "",
	// D0-D7 (RGMII4/MAC4 pins — MAC4 carries NCSI)
	"", "", "", "", "", "", "", "",
	// E0-E7 (RGMII4/MAC4 pins continued)
	"", "", "", "", "", "", "", "",
	// F0-F7 (GPIOF0-F7 = SD1/PWM8-15, pulled down — unused on Q2C)
	"", "", "", "", "", "", "", "",
	// G0-G7 (GPIOG0-G7 = SD2/SALT, pulled down — unused on Q2C)
	"", "", "", "", "", "", "", "",
	// H0-H7 (H0-H3 = SGPIOM1 to PLD; H4-H7 = I2C15/I2C16)
	"", "", "", "", "", "", "", "",
	// I0-I7 (I0-I4=JTAG-M2 to HPM; I5-I7=ACPI PLD_BMC_GPIOI5/6/7)
	"", "", "", "", "", "", "", "",
	// J0-J7 (I2C bus pins)
	"", "", "", "", "", "", "", "",
	// K0-K7 (I2C bus pins)
	"", "", "", "", "", "", "", "",
	// L0-L7 (I2C/VGA pins)
	"", "", "", "", "", "", "", "",
	// M0-M7 (UART1 modem control; M6=UART1 TX, M7=UART1 RX to PLD [pg 29])
	"", "", "", "", "", "", "", "",
	// N0-N7 (UART2; N6=UART2 TX, N7=UART2 RX to PLD [pg 27])
	"", "", "", "", "", "", "", "",
	// O0-O7 (GPIOO bank: PWM0-7 function — BMC→PLD control outputs)
	// All balls confirmed from schematic pg 23 (AST2600 4/6), 2026-03-05 PDF read.
	// O0 (AD26): unassigned   O4 (AD25): unassigned
	// O1 (AD22): BMC_PLD_GPIOO1 → PLD [pg 27]
	// O2 (AD23): BMC_PLD_GPIOO2 → PLD PROGRAMN (PLD programming control)
	// O3 (AD24): BMC_PLD_GPIOO3 → PLD [pg 27]
	// O6 (AC24): BMC_PLD_GPIOO6 → PLD JTAGENB (PLD JTAG enable)
	// O7 (AC23): BMC_PLD_GPIOO7 → PLD [pg 27]
	"",               // O0 (AD26) unassigned
	"bmc-pld-gpioo1", // O1 (AD22) BMC_PLD_GPIOO1 → PLD [pg 27]
	"pld-programn",   // O2 (AD23) BMC_PLD_GPIOO2 → PLD PROGRAMN
	"bmc-pld-gpioo3", // O3 (AD24) BMC_PLD_GPIOO3 → PLD [pg 27]
	"",               // O4 (AD25) unassigned
	"",               // O5 (AC22) unassigned
	"pld-jtagenb",    // O6 (AC24) BMC_PLD_GPIOO6 → PLD JTAGENB
	"bmc-pld-gpioo7", // O7 (AC23) BMC_PLD_GPIOO7 → PLD [pg 27]
	// P0-P7 (GPIOP bank: PWM8-15/THRU function — mixed input/output)
	// All balls confirmed from schematic pg 23 (AST2600 4/6), 2026-03-05 PDF read.
	// THRU pairs: P0(THRUIN0)/P1(THRUOUT0), P2/P3, P4/P5.
	// P0 (AB22): PCIE_HPM_SCM_PLD_PERST_N — INPUT from PLD [pg 27] via THRUIN0
	// P1 (W24):  BMC_PLD_GPIOP1 — OUTPUT to PLD [pg 31] via THRUOUT0
	// P2 (AA23): unassigned (THRUIN1)
	// P3 (AA24): BMC_PLD_GPIOP3 — OUTPUT to PLD [pg 31] via THRUOUT1
	// P4 (W23):  unassigned (THRUIN2)
	// P5 (AB23): BMC_PLD_GPIOP4 — OUTPUT to PLD [pg 30] via THRUOUT2
	//            (PLD names this "GPIOP4" — maps to AST2620 GPIOP5/THRUOUT2)
	// P6 (AB24): PCIE_AST2600_RST# — OUTPUT to gold finger [pg 9]
	// P7 (Y23):  FM_BMC_HEARTBEAT_N — BMC heartbeat to PLD (HBLED# function)
	"pcie-hpm-scm-pld-perst-n", // P0 (AB22) INPUT from PLD [pg 27]
	"bmc-pld-gpiop1",            // P1 (W24)  OUTPUT to PLD [pg 31]
	"",                          // P2 (AA23) unassigned
	"bmc-pld-gpiop3",            // P3 (AA24) OUTPUT to PLD [pg 31]
	"",                          // P4 (W23)  unassigned
	"bmc-pld-gpiop4",            // P5 (AB23) OUTPUT to PLD [pg 30]
	"pcie-ast2600-rst-n",        // P6 (AB24) PCIE_AST2600_RST# [pg 9]
	"fm-bmc-heartbeat-n",        // P7 (Y23)  FM_BMC_HEARTBEAT_N (HBLED#)
	// Q0-Q7 (GPIOQ bank: TACH0-7 function — PLD→BMC status inputs)
	// All balls confirmed from schematic pg 23 (AST2600 4/6), 2026-03-05 PDF read.
	// Q1 (AB25): unlabeled in schematic — possibly PLD_BMC_GPIOQ1 or unused.
	// Q2 (Y24): no connect (confirmed in schematic).
	// Signals confirmed from PLD pages 27/28/31.
	// Q6/Q7 CORRECTED: Q6=Y25 and Q7=AA26 (previously swapped in DTS).
	"pld-bmc-gpioq0", // Q0 (AA25) PLD_BMC_GPIOQ0 [pg 27]
	"",               // Q1 (AB25) unlabeled/unused
	"",               // Q2 (Y24)  no connect
	"pld-bmc-gpioq3", // Q3 (AB26) PLD_BMC_GPIOQ3 [pg 31]
	"pld-bmc-gpioq4", // Q4 (Y26)  PLD_BMC_GPIOQ4 [pg 31]
	"pld-bmc-gpioq5", // Q5 (AC26) PLD_BMC_GPIOQ5 [pg 27]
	"pld-bmc-gpioq6", // Q6 (Y25)  PLD_BMC_GPIOQ6 [pg 27] — CORRECTED (was AA26)
	"pld-bmc-gpioq7", // Q7 (AA26) PLD_BMC_GPIOQ7 [pg 28] — CORRECTED (was Y25)
	// R0-R7 (GPIOR bank: TACH8-15 function — mixed input/output)
	// All balls confirmed from schematic pg 23 (AST2600 4/6), 2026-03-05 PDF read.
	// CORRECTIONS: R0=V25, R1=U24, R2=V24, R3=V26, R4=U25 (all shifted vs old DTS).
	// R3 (V26): unassigned (not fm-bmc-ready-n — that is at R4).
	// R4 (U25): FM_BMC_READY_N — OUTPUT (was wrongly at R3 in old DTS).
	"pld-bmc-gpior0",  // R0 (V25) PLD_BMC_GPIOR0 INPUT [pg 27] — CORRECTED (was U24)
	"pld-bmc-gpior1",  // R1 (U24) PLD_BMC_GPIOR1 INPUT [pg 27] — CORRECTED (new)
	"pld-bmc-gpior2",  // R2 (V24) PLD_BMC_GPIOR2 INPUT [pg 27] — CORRECTED (was V26)
	"",                // R3 (V26) unassigned — CORRECTED (fm-bmc-ready-n was wrong)
	"fm-bmc-ready-n",  // R4 (U25) FM_BMC_READY_N OUTPUT [pg 27] — CORRECTED (was R3)
	"pwrgd-p12v-aux1", // R5 (T23) PWRGD_P12V_AUX1 INPUT [pg 27] ✓
	"fm-thermtrip-n",  // R6 (W26) FM_THERMTRIP_N INPUT via R86 [pg 31] ✓
	"irq-smi-bmc-n";   // R7 (U26) IRQ_SMI_BMC_N INPUT [pg 27] ✓
	// Signals confirmed from PLD schematic but AST2620 bank/bit still TBD:
	//   irq-nmi-event-n      ← IRQ_NMI_EVENT_R_N [pg 28]
	//   sys-pwrok-bmc        ← SYS_PWROK_BMC [pg 28] → AST2620 GPIOV/GPIOI region
	//   fm-bios-post-cmplt-n ← FM_BIOS_POST_CMPLT_N [pg 28]
	//   pld-irq-n            ← PLD_IRQ_N [pg 28]
	//   rst-rsmrst-n         ← RST_RSMRST_N [pg 28]
	//   rst-pfr-bmc-ssprst-n ← RST_PFR_BMC_SSPRST_N [pg 28]
};

// ---------------------------------------------------------------------------
// i2c15 — LOCAL DC-SCM bus (BMC_I2C15, signal I2C_BMC_R_SCL15/SDA15)
//
// AST2620 pins: GPIOH4=D18 (SCL), GPIOH5=B17 (SDA) — muxed from SGPS1
// This bus is entirely within the DC-SCM module and does NOT go through
// the gold finger connector.
//
// Confirmed devices (from schematic pg 34 "TMP_EE_RTC" and pg 36 "PMIC",
//                   full PDF read 2026-03-05):
//   TEMP1        — LM73CIMK temp sensor at 0x48 (part confirmed)
//   TEMP2        — LM73CIMK temp sensor at 0x49 (part confirmed)
//   FRU EE       — ST M24C64-RMN6TP EEPROM at 0x50 (8KB, pagesize 32B)
//   RTC          — Epson RX8130CE real-time clock at 0x32 (part confirmed)
//   PMIC         — APW6016P1 DC-DC converter at 0x12 (part confirmed)
//   SCM PLD      — Platform Logic Device at 0x40 (update/programming interface)
//                  Also exposed at 0x6F via PFR_I2C5 on carrier (TBD)
// ---------------------------------------------------------------------------
&i2c15 {
	status = "okay";

	scm_temp1: temperature-sensor@48 {
		compatible = "ti,lm73";
		reg = <0x48>;
		label = "scm_temp1";
		#thermal-sensor-cells = <0>;
	};

	scm_temp2: temperature-sensor@49 {
		compatible = "ti,lm73";
		reg = <0x49>;
		label = "scm_temp2";
		#thermal-sensor-cells = <0>;
	};

	scm_fru: eeprom@50 {
		compatible = "st,m24c64";
		reg = <0x50>;
		label = "scm_fru";
		pagesize = <32>;
	};

	scm_rtc: rtc@32 {
		compatible = "epson,rx8130";
		reg = <0x32>;
	};

	scm_pmic: regulator@12 {
		/* APW6016P1 step-down DC-DC converter (confirmed from pg 36) */
		compatible = "anpec,apw6016p1";
		reg = <0x12>;
	};

	scm_pld: i2c-slave@40 {
		/* SCM PLD — Lattice LCMXO3D-9400HC-5BG256C (BGA256 16x16)
		 * This address (0x40) is the update/programming interface.
		 * PLD firmware provides: fan control, SGPIO panel LEDs (SGPIOM1),
		 * SGPIO HPM chain (SGPIO_SCM_HPM_CLK/LD/DO/DI → HPM FPGA [9]),
		 * SGPIO PFR chain (SGPIO_PFR_LD_N, SGPIO_PFR_DIN → AST1060 [10]),
		 * BMC↔PLD GPIO bus (PLD_BMC_GPIO0-7 on GPIOO, BMC_PLD_GPIO0-7 on GPIOP),
		 * UART5 data channel (UART5_TX/RX_BMC_PLD_DATA [21,26]).
		 * A second address 0x6F is accessible via PFR I2C5 (TBD).
		 * Replace compatible with actual userspace/kernel driver when available. */
		reg = <0x40>;
	};
};

// ---------------------------------------------------------------------------
// i2c16 — BMC ↔ PROT_AST1060 (PFR chip) primary I2C link (BMC_I2C16)
//
// Schematic signal: I2C_BMC_PFR_SCL16_R / I2C_BMC_PFR_SDA16_R
// AST2620 pins: GPIOH6=C17 (SCL), GPIOH7=E18 (SDA)
//
// PFR chip: Aspeed PROT_AST1060 (firmware resilience co-processor)
//   The AST1060 sits between the BMC and carrier-board I2C buses, acting as
//   a firewall.  It exposes filtered buses to the gold finger (SMBF1-4) and
//   provides a mailbox interface at I2C_I3C_1V8_12 (gold finger A53/A59).
//
//   BMC → AST1060 management: also via BMC_I2C12, BMC_I2C7, BMC_I2C9,
//                              BMC_I2C6, BMC_HVI3C3_I2C1 (bus topology TBD).
//   AST1060 I2C address for BMC access: TBD (typically 0x38 or 0x70).
// ---------------------------------------------------------------------------
// &i2c16 is not defined in aspeed-g6.dtsi (AST2600 only has i2c0–i2c15).
// BMC_I2C16 / PFR AST1060 link — enable once upstream DTSI adds the label.
// &i2c16 {
// 	status = "okay";
// 	/* TODO: add AST1060 node (address TBD) once PFR firmware I2C map is confirmed */
// };

// ---------------------------------------------------------------------------
// LPC / KCS — host IPMI interface (BMC receives LPC from eSPI-to-LPC bridge)
//
// AMD COMe CPU → eSPI → ESPI_HPMCTRL bridge → LPC → AST2620 GPIOW pins
// The BMC is in standard LPC mode (not eSPI peripheral mode).
//
// KCS channel IO port address: TBD — standard IPMI is 0xCA2/0xCA3 (KCS3).
// Confirm from BIOS config or ipmitool on the host side on first boot.
// ---------------------------------------------------------------------------
// &lpc_ctrl {
//     status = "okay";
// };
// &kcs3 {
//     status = "okay";
//     aspeed,lpc-io-reg = <0xCA2 0xCA3>;
// };

// SGPIOM0 — NOT used on Q2C (no SGPIOM0 signals found in schematic).

// ---------------------------------------------------------------------------
// SGPIOM2 — second SGPIO master chain between BMC and SCM PLD
//
// All four SGPIOM2 signals confirmed from PLD U2 schematic [pg 20]:
//   SGPIOM2_BMC_PLD_CLK  — BMC drives clock  (IN to PLD)  [pg 20]
//   SGPIOM2_BMC_PLD_DO   — BMC drives data   (IN to PLD)  [pg 20]
//   SGPIOM2_BMC_PLD_LD   — BMC drives LOAD   (IN to PLD)  [pg 20]
//   SGPIOM2_BMC_PLD_DI   — PLD drives data   (OUT from PLD, BMC reads) [pg 20]
//
// BMC is SGPIO master; SCM PLD is slave.  This chain carries PLD status bits
// that don't fit on SGPIOM1 (panel LEDs) or the GPIOO bank.
//
// AST2620 pinmux: GPIOA4-A7 (balls K26/L24/L23/K25) confirmed from pg 20
// schematic review, 2026-03-05.  Use pinctrl_sgpm2ck/ld/o/i_default.
// Bit count and data format: TBD from PLD firmware docs.
// ---------------------------------------------------------------------------
// &sgpiom2 {
//     status = "okay";
//     /* SCM PLD SGPIOM2 slave chain — bit count TBD from PLD firmware */
//     ngpios = <TBD>;
//     gpio-line-names = /* TBD */;
// };

// ---------------------------------------------------------------------------
// Fan PWM/tach — NOT driven directly by AST2620 PWM hardware.
// AST2620 GPIOF0-F7 carry PWM8-15 function but are pulled down (R31T 100k)
// and not connected to fans on Q2C.
// Fan control is via the SCM PLD at i2c15 @0x40.
// ---------------------------------------------------------------------------
// pwm_tacho does not exist in aspeed-g6.dtsi (AST2600). The old combined
// PWM/tach controller is only in AST2400/AST2500 (g4/g5). Fan control on
// Q2C is via the SCM PLD over i2c15 @0x40, so no direct PWM is needed.
// &pwm_tacho {
// 	status = "disabled";
// };

// ---------------------------------------------------------------------------
// UART / Console
//
// UART0_BMC + UART1_BMC → physical MUX (UART_SEL push-button) → Console Board → UART_RJ45
// Console UART: ttyS4 (UART5) — confirmed from ast2600_openbmc_spl_defconfig.
//
// BMC ↔ SCM PLD UART channels (confirmed from PLD U2 schematic):
//   UART2_TX_BMC_PLD_DATA [21]    — BMC → PLD  (IN to PLD)
//   UART4_TX_BMC_PLD_DATA [21]    — PLD → BMC  (OUT from PLD, BMC receives on UART4 RX)
//   UART5_RX_PLD_BMC_DATA [21,31] — BMC → PLD  (BMC UART5 TX, IN to PLD, via R328 33Ω)
//   UART5_TX_BMC_PLD_DATA [21,26] — PLD → BMC  (BMC UART5 RX, via R371 33Ω + JP1 debug)
//
// PFR-related UART channels (via PLD, not direct to BMC):
//   UART1_TX_PFR_PLD_DATA [12,14,31] — PFR → PLD (via R349 33Ω, OUT from PLD side)
//
// Enable UART nodes once protocol per channel is defined and ttyS mapping confirmed.
// ---------------------------------------------------------------------------
// &uart5 {
//     status = "okay";
//     /* BMC ↔ SCM PLD extended data channel (UART5_TX/RX_BMC_PLD_DATA) */
// };

// ---------------------------------------------------------------------------
// Management Network
//
// 1. OOB NIC — Intel I210 via PCIe Gen2 x1 (reset: I210_RST_L)
// 2. NCSI — AMD x86 COMe NIC → DC-SCM MAC4 (RGMII4 pins confirmed from pg 23)
//
// AST2620 MAC4 = kernel mac3 (0-indexed).  RGMII4 signal group confirmed on
// AST2620 ball D-row (MAC4 RGMII signals) from schematic pg 23, 2026-03-05.
// ---------------------------------------------------------------------------
&mac3 {
	use-ncsi;
	status = "okay";
};

// ---------------------------------------------------------------------------
// ADC — Voltage Rail Sensing
// Resistors confirmed from schematic pg 32 (zoomed images 2026-03-04).
// Channel → pin mapping confirmed from schematic pg 23 (2026-03-04 image).
//
// aspeed_adc iio driver: V_real = (raw × 1800 mV / 4096) × scale_factor
// Scale factor = (R_top + R_bottom) / R_bottom (direct-sense rails = 1.0).
//
// FULL CONFIRMED MAPPING (13 active channels, confirmed from pg 23 + pg 32 PDF):
//   Ch  GPIO/SALT  Ball  Signal                      R_top  R_bot  Scale
//   ──  ─────────  ────  ──────────────────────────  ─────  ─────  ─────
//   0   GPIT0      AD20  VCC_12V_SENSE (P12V_AUX)    20k   2.49k  9.036
//   1   GPIT1      AC18  VCC_3V3_SENSE                3k    2k    2.500
//   2   GPIT2      AE19  VCC_2V5_SENSE                2k   2.49k  1.803
//   3   GPIT3      AD19  VCC_1V8_SENSE                2k    3k    1.667
//   4   GPIT4      AC19  VCC_DDRVDDQ_SENSE (1.2V)  direct  —     1.000
//   5   GPIT5      AB19  VCC_1V0_SENSE (1.0V)      direct  —     1.000
//   6   GPIT6      AB18  VCC_DDRVTT_SENSE (~0.6V)  direct  —     1.000
//   7   GPIT7      AE18  A_P3V_BAT_SCALED            200k  100k   3.000
//                          (MOSFET OR: D7/D8=SBR1A040S3-7, Q=MTDH500RETU-G)
//   8   GPIU0/S9   AB16  VCC_3V3_RGM_SENSE            3k    2k    2.500
//   9   GPIU1/S10  AA17  VCC_SCM_HPM_FRU_3V3_SENSE   3k    2k    2.500
//  10   GPIU2/S11  AB17  VCC_LS_CH1_3V3_SENSE         3k    2k    2.500
//  11   GPIU3/S12  AE16  VCC_LS_CH2_1V8_SENSE         2k    3k    1.667
//  12   GPIU4/S13  AC16  PECI_VDD_SENSE (~1V)      direct  —     1.000
//  13   GPIU5/S14  AA16  GND (unused, tied low)
//  14   GPIU6/S15  AD16  GND (unused, tied low)
//  15   GPIU7/S16  AC17  unused
//
// Ball assignments for ADC8-12 corrected from full PDF read (pg 23, 2026-03-05):
//   Prior DTS had AB17/TBD/AE16/AC16/AA16; corrected to AB16/AA17/AB17/AE16/AC16.
// ---------------------------------------------------------------------------
&adc0 {
	// ADC0-7: GPIT0-7 (balls AD20, AC18, AE19, AD19, AC19, AB19, AB18, AE18)
	// See channel table above for signal names and scale factors.
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
		     &pinctrl_adc2_default &pinctrl_adc3_default
		     &pinctrl_adc4_default &pinctrl_adc5_default
		     &pinctrl_adc6_default &pinctrl_adc7_default>;
};

&adc1 {
	// ADC8-12: GPIU0-4/SALT9-13 (balls AB16, AA17, AB17, AE16, AC16)
	// ADC12 (GPIU4/SALT13, ball AC16) = PECI_VDD_SENSE — enabled here.
	// ADC13-15 (GPIU5-7, balls AA16/AD16/AC17) tied to GND or unused.
	// See channel table above for signal names and scale factors.
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_adc8_default  &pinctrl_adc9_default
		     &pinctrl_adc10_default  &pinctrl_adc11_default
		     &pinctrl_adc12_default>;
};

